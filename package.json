{
  "name": "otis-wochenrapport",
  "private": true,
  "version": "1.0.0",
  "description": "OTIS Wochenrapport PWA - Weekly report app for elevator technicians",
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:backend": "cd apps/backend && python -m uvicorn src.main:app --reload --port 8000",
    "build": "cd apps/web && npm run build",
    "vercel-build": "cd apps/web && npm ci --no-audit --no-fund && npm run build",
    "build:web": "cd apps/web && npm run build",
    "build:backend": "cd apps/backend && pip install -r requirements.txt",
    "start:backend": "cd apps/backend && python -m uvicorn src.main:app --host 0.0.0.0 --port 8000",
    "preview": "cd apps/web && npm run preview",
    "setup": "cd apps/web && npm install && cd ../.. && cd apps/backend && pip install -r requirements.txt",
    "supabase:start": "cd apps/web && npx supabase start",
    "supabase:stop": "cd apps/web && npx supabase stop",
    "supabase:status": "cd apps/web && npx supabase status",
    "supabase:reset": "cd apps/web && npx supabase db reset",
    "dev:all": "npm run supabase:start && npm run dev",
    "supabase:studio": "cd apps/web && npx supabase status",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:backend": "docker compose -f docker-compose.backend.yml up -d",
    "docker:backend:stop": "docker compose -f docker-compose.backend.yml down"
  },
  "keywords": ["otis", "wochenrapport", "pwa", "offline-first"],
  "license": "MIT"
}
