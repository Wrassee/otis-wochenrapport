# =================================================================
# OTIS Wochenrapport — Backend Environment Variables
# =================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =================================================================

# ─── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── CORS / Frontend URL ───────────────────────────────────────
# The production frontend URL that will call this API.
# For Render deploy: set this in Render dashboard → Environment
# For local dev: keep as-is (defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ─── Server Port ───────────────────────────────────────────────
# Render automatically sets PORT. For local dev, defaults to 8000.
# PORT=8000
