[TEMPLATE]
# =================================================================
# OTIS Wochenrapport — Frontend Environment Variables
# =================================================================
# Copy this file to .env and fill in your values.
# Vite requires VITE_ prefix for client-exposed variables.
# =================================================================

# ─── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Backend URL (Render / Local) ──────────────────────────────
# For local dev: http://localhost:8000
# For production: https://your-app-name.onrender.com
# This is used by the Export page to generate Excel files.
VITE_RENDER_URL=http://localhost:8000

# ─── Sentry (OPTIONAL) ──────────────────────────────────────────
# Error monitoring. Leave EMPTY to disable — the app then runs exactly as
# before, with no Sentry bundle overhead. Get a DSN at sentry.io →
# your project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=
