{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "cd ../backend && python -m uvicorn src.main:app --reload --port 8000",
    "dev": "concurrently -n vite,backend -c cyan,yellow \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:docker": "cd .. && docker compose up -d",
    "dev:docker:stop": "cd .. && docker compose down",
    "dev:docker:backend": "cd .. && docker compose -f docker-compose.backend.yml up -d",
    "dev:docker:backend:stop": "cd .. && docker compose -f docker-compose.backend.yml down",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:reset": "npx supabase db reset",
    "supabase:studio": "npx supabase status",
    "dev:docker:full": "cd .. && docker compose -f docker-compose.yml -f docker-compose.local.yml up -d"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
